CONFIG_EARLY_PRINTK=y
CONFIG_GPIOLIB=y
CONFIG_GPIOLIB_IRQCHIP=y
CONFIG_GPIO_GENERIC=y
CONFIG_GPIO_SYSFS=y
CONFIG_HZ=250
CONFIG_HZ_250=y
CONFIG_IRQ_MIPS_CPU=y
CONFIG_MIPS_ASID_BITS=8
CONFIG_MIPS_ASID_SHIFT=0
CONFIG_MIPS_L1_CACHE_SHIFT=5
